{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pocket-agent-cloud",
  "main": "worker.js",
  "compatibility_date": "2026-11-21",
  "workers_dev": true,
  "keep_vars": true,
  "observability": {
    "enabled": false
  },
  "vars": {
    "BASE_URL": "https://pocket-agent-cloud.enderscheng.workers.dev",
    "CALENDAR_TIME_ZONE": "Europe/Copenhagen"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pocket-agent-db",
      "database_id": "3381763b-3ffb-4fe1-887c-668d30c2d761"
    }
  ],
  "ai": {
    "binding": "AI"
  }
}
